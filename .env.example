# Local Terraform development environment
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=eu-central-1
TF_STATE_BUCKET=test
TF_LOCK_TABLE=terraform-lock
EKS_CLUSTER_NAME=airflow-cluster
AIRFLOW_NAMESPACE=airflow

# Optional: override tfvars values for local runs
TF_VAR_aws_region=eu-central-1
TF_VAR_environment=dev
TF_VAR_cluster_name=airflow-cluster
TF_VAR_database_password=change-me-before-apply
